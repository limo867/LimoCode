# Copy this file to .env and fill in your provider credentials.
# .env is ignored by Git and is read automatically from the workspace root.

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional explicit HTTP(S) proxy for model API traffic. Leave empty to use
# the system/environment proxy configuration.
LLM_PROXY=
# Optional comma-separated allowlist for /models and /model switching.
LLM_MODELS=gpt-4o-mini
LLM_TIMEOUT=60
LLM_RETRIES=1
LLM_RETRY_BASE_DELAY_MS=250
# Minimum time between model requests in a process. Zero disables rate limiting.
LLM_MIN_REQUEST_INTERVAL_MS=0
AGENT_WORKSPACE=.
AGENT_MAX_TURNS=60
AGENT_COMMAND_TIMEOUT=30
# Seconds to wait for a local approval of a high-risk command.
AGENT_COMMAND_APPROVAL_TIMEOUT=120
# File writes default to approval. Set to auto only when you want normal
# Agent edits applied immediately; destructive commands still require approval.
AGENT_PERMISSION_MODE=approval
AGENT_MAX_OUTPUT_CHARS=12000
AGENT_MAX_FILE_CHARS=200000
AGENT_MAX_HISTORY_MESSAGES=30
AGENT_MAX_HISTORY_CHARS=8000
AGENT_MAX_CONTEXT_TOKENS=128000
AGENT_COMPACTION_THRESHOLD=0.8
# Maximum characters of relevant project memory injected into one task prompt.
AGENT_MEMORY_CONTEXT_CHARS=4000
AGENT_HISTORY_DB=.coding-agent/tasks.sqlite3
AGENT_MEMORY_DB=.coding-agent/memory.sqlite3
# Exact dangerous commands explicitly approved by the local operator, separated by ;;.
AGENT_APPROVED_COMMANDS=
